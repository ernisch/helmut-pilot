OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Azure OpenAI (EU, DSGVO-konform) – hat Vorrang vor OPENAI_API_KEY wenn gesetzt
# Endpoint ohne trailing slash, z.B. https://helmut-resource.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# CRON_SECRET: PFLICHT fuer die Cron-Endpunkte (/api/cron/*). Seit dem P1-Fix
# sind diese Routen FAIL CLOSED: ist CRON_SECRET nicht gesetzt, antworten sie mit
# 503 (deaktiviert) statt offen zu sein. In Vercel unter Project → Settings →
# Environment Variables setzen (denselben Wert wie GitHub-Secret HELMUT_CRON_SECRET
# im Briefing-Watchdog). Aufruf: Header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
PILOT_SECRET=
HELMUT_ALLOW_QUERY_SECRETS=false
# Admin-/Debug-Bypass fuer /api/debug/* (Bearer-Header). Ohne Wert faellt der
# Code auf CRON_SECRET zurueck — empfohlen: SEPARAT setzen, damit das Cron-Secret
# keinen Debug-Vollzugriff gewaehrt (Rotation: docs/betrieb/secret-rotation.md).
HELMUT_ADMIN_SECRET=

# Optional: LLM-Preise (USD pro 1 Mio. Token) fuer die Kostenschaetzung im
# LLM-Usage-Log ueberschreiben. JSON, z. B. {"gpt-5-mini":{"in":0.25,"out":2.0}}.
# Ohne Wert gelten die (geschaetzten) Standardpreise in storage.js.
HELMUT_LLM_PRICE_JSON=

# --- Datenmotor V2: LLM-Kostenkontrolle ---
# Max. LLM-Calls pro Mandat (politicianId) pro Kalendertag. Leer/0 = kein Limit.
# Wird das Limit erreicht, faellt der Briefing-Motor sauber auf den Regelmotor
# zurueck (kein KI-Call) und protokolliert den Skip im llmUsage-Log.
# FAIL-CLOSED: Nur eine positive ganze Zahl setzt das Limit. Fehlend, leer, 0,
# negativ oder unparsebar => Schutzlimit 50 Calls/Tag (es gibt bewusst KEINEN
# "kein Limit"-Wert; wer mehr braucht, setzt explizit eine hohe Zahl).
HELMUT_MAX_LLM_CALLS_PER_DAY=

# Reservierter Understanding-Mindestanteil am Tageslimit (Anzahl Calls). Nur
# wirksam, wenn HELMUT_MAX_LLM_CALLS_PER_DAY gesetzt ist: Nicht-Understanding-
# Pfade (Buero/Kommunikation/Lage/App-Start/Backfills) duerfen dann nur bis
# (Limit - Reserve) reservieren, Understanding bis zum vollen Limit. Verhindert,
# dass Buero-Calls das Understanding-Budget aushungern (F5-Befund). Leer/0 = aus.
# Ungueltiger Wert -> 0 (das Tageslimit selbst bleibt unberuehrt). Empfehlung
# Production: zusammen mit Limit 100 auf 30 setzen (Runbook
# docs/betrieb/llm-budget-reservierung.md).
HELMUT_LLM_RESERVE_UNDERSTANDING=

# --- Datenmotor V3: Sicherheitsnetz (C1) — beide Flags standardmaessig AUS ---
# Budget-Check im FEHLERFALL fail-closed statt fail-open. Leer/0 = AUS (bisheriges
# Verhalten: bei Storage-Fehler wird der KI-Call ERLAUBT, damit die App laeuft).
# 1/true/on = AN: bei Fehler wird der KI-Call VERWEIGERT (lieber ein uebersprungenes
# Briefing als eine unkontrollierte KI-Rechnung). Fuer die geteilten, teuren
# V3-Understanding-Calls gedacht; noch nicht scharf schalten.
HELMUT_LLM_BUDGET_FAIL_CLOSED=
# Globaler Understanding-Lock (mandantenlos) fuer die V3-Understanding Engine.
# Leer/0 = AUS: acquireGlobalUnderstandingLock ist ein No-Op (immer granted, schreibt
# nichts). 1/true/on = AN: ein globaler Lock verhindert, dass zwei ueberlappende
# Cron-Laeufe denselben KI-Understanding-Call doppelt fahren (doppelte Kosten).
HELMUT_UNDERSTANDING_LOCK=
# Modell fuer den globalen Understanding-Call (C8). Auf Azure wird IMMER das
# konfigurierte Deployment genutzt (AZURE_OPENAI_DEPLOYMENT = gpt-5-mini); dieser
# Wert wirkt nur bei OpenAI direkt. Leer = gpt-5-mini.
HELMUT_UNDERSTANDING_MODEL=
# --- Datenmotor V3: KI-Understanding (C8) ---
# C8 ist der ERSTE Schritt mit echten KI-Kosten. Er verarbeitet die von C7c als
# status='pending' vorgemerkten Vorgaenge (1 KI-Call pro Vorgang, mandantenlos),
# erzwingt Structured Output gegen KNOWLEDGE_OBJECT_SCHEMA und speichert die Analyse
# mit understanding_status='complete' (bei ungueltiger KI/Fehler: 'failed', status
# bleibt 'pending' -> nie ausgeliefert). Aktiv nur mit HELMUT_V3_STORE=1 + KI-Key +
# (empfohlen) HELMUT_UNDERSTANDING_LOCK=1 + HELMUT_LLM_BUDGET_FAIL_CLOSED=1. Ohne
# diese Flags bleibt C8 inert (No-Op). Erst das V3-Schema einspielen (psql < supabase/schema.sql).
# Goldset-Eval: npm run test:understanding-eval (offline gratis). Echte KI-Eval:
HELMUT_UNDERSTANDING_EVAL_LIVE=

# --- Account-/Auth-Modus (MVP) ---
# Wenn HELMUT_AUTH_MODE=accounts, ersetzt der Konto-Login den geteilten Pilot-Code.
# Solange leer/anders, bleibt der bestehende Pilot-Gate aktiv (Feature-Flag).
HELMUT_AUTH_MODE=
# Erst-Admin wird beim Serverstart angelegt, falls noch kein Admin existiert.
# Nach dem ersten Start koennen diese Variablen wieder entfernt werden.
HELMUT_ADMIN_EMAIL=
HELMUT_ADMIN_PASSWORD=
HELMUT_ADMIN_NAME=Administrator
# Notfall: HELMUT_ADMIN_RESET=1 setzt beim Start E-Mail+Passwort des bestehenden
# Admins zwangsweise auf die Env-Werte (gegen Tippfehler). Danach wieder entfernen.
HELMUT_ADMIN_RESET=
# Session-Laufzeit in ms (Default 30 Tage, rollierend bei jedem App-Start verlaengert)
# und max. Tagesinput-Eintraege pro Mandat/Tag.
HELMUT_SESSION_TTL_MS=
HELMUT_MAX_DAILY_INPUTS=3

# Morgen-Push fuer ALLE Profile (Mehrmandanten-Vorbereitung, Audit 2026-07).
# Leer/0 = AUS (bisheriges Verhalten: nur das Default-Mandat erhaelt den
# 05:00-Push). 1/true/on = AN: der morning-briefing-Cron loopt wie der
# lage-briefing-Cron ueber alle aktiven Profile (deaktivierte werden
# uebersprungen, per-Profil try/catch, 240s-Zeitbudget). 0 KI-Kosten (der
# Briefing-Build ist eine Lese-Transformation); Push nur bei echtem Inhalt.
HELMUT_MORNING_PUSH_ALL_PROFILES=

# PARDOK-/parldok-Abruf (Berlin/Brandenburg, Audit 2026-07): eigener, hart
# begrenzter Streaming-Abruf fuer structured_download-Quellen. Die echten
# Exporte (BE ~48 MB, BB ~12 MB) sprengen das 10-MiB-Standard-Crawl-Limit.
# Leer = Defaults: 64 MiB Byte-Budget, Fruehabbruch nach 800 Records.
HELMUT_PARDOK_MAX_RESPONSE_BYTES=
HELMUT_PARDOK_MAX_RECORDS=

# Supabase (Service Role NUR serverseitig, niemals im Frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HELMUT_STORAGE_BACKEND=

# P0-2-Folgearbeit (Sprint 3, docs/auth-service-role-matrix.md): optionaler
# Tenant-JWT-Modus fuer die 8 klar abgegrenzten Live-Nutzerpfade (Lage-Cache,
# Office-Outputs) — zweite Verteidigungslinie zusaetzlich zu den in
# supabase/migrations/20260712_tenant_rls_policies.sql entworfenen RLS-Policies.
# Default AUS: leer/0 = kein Verhaltensunterschied (weiterhin service_role
# fuer alles). NUR aktiv, wenn HELMUT_TENANT_JWT_MODE=1 UND beide Secrets
# unten gesetzt sind (tenantJwtModeEnabled() in lib/helmut/storage.js).
# NICHT ohne die in docs/rls-activation-rollout.md beschriebene Reihenfolge
# aktivieren (Migration MUSS zuerst auf der DB angewendet sein).
HELMUT_TENANT_JWT_MODE=
# Supabase Auth > JWT Settings — MUSS exakt dem Projekt-Secret entsprechen,
# sonst schlaegt jede PostgREST-Verifikation fehl. Zum SIGNIEREN (App-seitig),
# nicht zu verwechseln mit SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_JWT_SECRET=
# Supabase API Settings — publishable Anon-Key (kein Secret im eigentlichen
# Sinn, aber projektspezifisch; wird als apikey-Header fuer authenticated-
# Requests statt des service_role-Keys gesendet).
SUPABASE_ANON_KEY=
# Helmut Core V3 Store (C5): additive relationale V3-Tabellen (raw_documents,
# knowledge_objects, ...) benutzen. Leer/0 = AUS (Default): die V3-Storage-Funktionen
# sind inert (no-op), die App laeuft exakt wie bisher ueber den Blob-Store. 1/true/on
# = AN: saveRawDocument/saveKnowledgeObject/... schreiben in die V3-Tabellen. Ist
# Supabase nicht verfuegbar, bleiben die Funktionen inert (kein Crash). Zuerst das
# V3-Schema einspielen: psql < supabase/schema.sql (rein additiv, loescht nichts).
HELMUT_V3_STORE=
# DSGVO-Datenminimierung (C6): maximale Laenge des in raw_documents gespeicherten
# Kontext-Snippets (summary). Leer = 240. Volltext/Artikelinhalt wird NIE gespeichert.
HELMUT_RAWDOC_SUMMARY_MAX=

# Helmut Core V3 — Matching Engine (C7a): pgvector-Aehnlichkeitssuche + harte
# Filter (Partei/Ausschuss/Wahlkreis), deterministisch, KEINE KI. Leer/0 = AUS
# (Default): runMatchingShadow ist inert (skipped). 1/true/on = AN. Braucht fuer
# echte Writes zusaetzlich HELMUT_V3_STORE + Supabase (sonst inert, kein Crash).
# Zuerst supabase/schema.sql einspielen (legt pgvector + matching_results additiv an).
HELMUT_V3_MATCHING=
# Dimension der deterministischen Merkmalsvektoren. Leer = 256. MUSS zur
# vector(N)-Spalte in supabase/schema.sql passen (dort ebenfalls 256).
HELMUT_MATCHING_DIM=


# Helmut Core V3 — Lazy Understanding-Trigger (C7c): merkt einen Vorgang nur dann
# als status='pending' vor, wenn er noch nicht analysiert ist UND ein Nutzer
# interessiert ist (deterministisches Matching). MACHT KEINEN KI-CALL (das ist C8).
# Leer/0 = AUS (Default): runLazyUnderstandingShadow ist inert (skipped). 1/true/on = AN.
HELMUT_V3_LAZY_UNDERSTANDING=

# Bundestag DIP-API (parlamentarische Vorgänge). Kostenloser Key, siehe
# https://dip.bundestag.de/über-dip/hilfe/api . Ohne Key bleibt das Feature inaktiv.
DIP_API_KEY=
DIP_WAHLPERIODE=21
# DIP als hochwertige PRIMÄRQUELLE behandeln (C3). Leer/0 = AUS (bisheriges
# Verhalten: DIP-Drucksachen laufen als normale Zusatzquelle mit). 1/true/on = AN:
# DIP-Items bekommen einen amtlichen Direktlink (linkType=direct) und hohe Priorität,
# damit sie den Kandidaten-Deckel/Retention überleben und im Client nicht als
# unpräziser Link ausgeblendet werden. Wirkt nur, wenn auch DIP_API_KEY gesetzt ist.
HELMUT_DIP_PRIMARY=

# Quellenarchitektur-Cutover: off/shadow/on. PFLICHT in Production (=on), sonst
# liefert der Crawl keinen neuen Stoff. Auch ueber helmut-flags.json steuerbar
# (Env hat Vorrang); Details docs/betrieb/env-inventar.md Abschnitt 4.
HELMUT_SOURCE_MODE=

# Web-Push (VAPID): Schluesselpaar mit scripts/generate-vapid-keys.js erzeugen.
# Ohne diese Werte ist Push deaktiviert (App laeuft normal). Rotation invalidiert
# ALLE bestehenden Push-Abos — nur bei Kompromittierung rotieren.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt-URI fuer Push-Dienste, z.B. mailto:kontakt@example.org
VAPID_SUBJECT=

# Alarmkanal 1: WhatsApp-Health-Report via CallMeBot (Telefonnummer mit
# Laendercode + per WhatsApp-Registrierung erhaltener API-Key). Ohne Werte wird
# dieser Kanal STILL uebersprungen.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Alarmkanal 2 (Zweitkanal): Health-Report zusaetzlich als JSON-POST an einen
# generischen Webhook (Slack/Discord/Zapier/E-Mail-Relais). Ohne: nur WhatsApp.
HELMUT_MONITORING_WEBHOOK_URL=

# Kanonischer Host fuer absolute Links/Redirects. Leer = helmut-pilot.vercel.app.
HELMUT_CANONICAL_HOST=

# Helmut Core V3 — Buero-Engine (C9): KI-gestuetzte Kommunikations-Generierung.
# 15 Kanaele: Rede, Pressemitteilung, LinkedIn, Statement, Newsletter, Talking Points,
# X/Twitter, Instagram, Facebook, Bluesky, TikTok, YouTube-Community, Buergerantwort,
# Krisenstatement, Interview-Vorbereitung.
# Caching: Gleicher Nutzer + Vorgang + Kanal -> kein zweiter KI-Call.
# Rate-Limiting: Max. HELMUT_OFFICE_DAILY_LIMIT Outputs pro Nutzer/Tag (Default 10).
# Leer/0 = AUS (Default). 1/true/on = AN. Braucht HELMUT_V3_STORE + Supabase fuer
# Caching und Rate-Limiting (ohne Store: inert, kein Crash). Setzt C8 voraus
# (understanding_status='complete' als Guard). DSGVO: kein PII im Prompt, kein
# userId im LLM-Log.
HELMUT_V3_OFFICE=
HELMUT_OFFICE_DAILY_LIMIT=
