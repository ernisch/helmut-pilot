OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
CRON_SECRET=
PILOT_SECRET=
HELMUT_ALLOW_QUERY_SECRETS=false

# --- Account-/Auth-Modus (MVP) ---
# Wenn HELMUT_AUTH_MODE=accounts, ersetzt der Konto-Login den geteilten Pilot-Code.
# Solange leer/anders, bleibt der bestehende Pilot-Gate aktiv (Feature-Flag).
HELMUT_AUTH_MODE=
# Erst-Admin wird beim Serverstart angelegt, falls noch kein Admin existiert.
# Nach dem ersten Start koennen diese Variablen wieder entfernt werden.
HELMUT_ADMIN_EMAIL=
HELMUT_ADMIN_PASSWORD=
HELMUT_ADMIN_NAME=Administrator
# Session-Laufzeit in ms (Default 12h) und max. Tagesinput-Eintraege pro Mandat/Tag.
HELMUT_SESSION_TTL_MS=
HELMUT_MAX_DAILY_INPUTS=3

# Supabase (Service Role NUR serverseitig, niemals im Frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HELMUT_STORAGE_BACKEND=
