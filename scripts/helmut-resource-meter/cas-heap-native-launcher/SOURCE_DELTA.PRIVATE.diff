+language plpgsql stable security invoker set search_path=pg_catalog as $f$
+declare reachable text[]; hashes text[]; bodies jsonb[]; refs jsonb[]; leaf_infos jsonb[]; lookup jsonb; kinds text[]; sizes bigint[];
