{
  "version": 2,
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "codex/ki-antwortumschlag-hardening": false,
      "claude/understanding-telemetrie-korrektur-ty5gb2": false,
      "claude/understanding-kapazitaet-diagnose-7meqjr": false
    }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": ".github/workflows/{briefing-watchdog,health-watch}.yml"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Strict-Transport-Security": "max-age=63072000"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/client.js",
      "dest": "/client.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/crawl",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/lage-check",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/health-report",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/pipeline",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/understanding",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/lage-briefing",
      "schedule": "45 5 * * *"
    },
    {
      "path": "/api/cron/lage-briefing-nachlauf",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/cron/lage-briefing-nachlauf",
      "schedule": "22 6 * * *"
    },
    {
      "path": "/api/cron/understanding",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/understanding-rueckstand",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/understanding-rueckstand",
      "schedule": "30 17 * * *"
    }
  ]
}
