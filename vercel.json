{
  "version": 2,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/client.js",
      "dest": "/client.js"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/crawl",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "0 20 * * *"
    }
  ]
}
