@@ -321,6 +323,13 @@ async function updateUser(id, patch = {}) {
       user.passwordHash = passwordHash;
       user.passwordSalt = passwordSalt;
     }
+    // Im wiederholbaren Auth-Schreibvorgang gegen genau den neuen Stand pruefen.
